# ── Required to deploy ────────────────────────────────────────────────

# Connexion PostgreSQL utilisée par l'app (Supabase : Transaction pooler,
# port 6543). Copier depuis Supabase : Project Settings > Database >
# Connection string > Transaction pooler. Voir SUPABASE.md.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion utilisée uniquement par les migrations Prisma (Supabase :
# Session pooler, port 5432 — pas la même URL que DATABASE_URL). Copier
# depuis Supabase : Project Settings > Database > Connection string >
# Session pooler. Voir SUPABASE.md.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

NODE_ENV=production

# The storefront's real URL — must match exactly or admin login/API calls
# will be rejected by CORS.
CLIENT_URL="https://your-domain.com"

# Signs admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# SMTP used to send the "new order" notification. Provider-specific — for
# Gmail this is an app password, not the account password.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""

# Where new-order notifications are sent
STORE_EMAIL=""

# ── Used once, to create the first admin account (npm run prisma:seed) ─
# Safe to remove after the first deploy — only read by the seed script.
SEED_ADMIN_NAME="Admin ikey."
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ── Optional — code already has sensible defaults ──────────────────────
# PORT=5000                                # cPanel sets this itself
# COOKIE_NAME="ikey_admin_session"
# MAIL_FROM_NAME="ikey."
# MAIL_FROM_ADDRESS="no-reply@your-domain.com"

# ── Stockage des photos produits — "local" (disque, par défaut) ou
#    "supabase" (Supabase Storage). Les 3 lignes SUPABASE_* ne sont lues
#    que si UPLOAD_DRIVER=supabase. Voir SUPABASE.md.
# UPLOAD_DRIVER=supabase
# SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# SUPABASE_SECRET_KEY=""                   # Settings > API Keys > secret key (server only, jamais exposée au client)
# SUPABASE_STORAGE_BUCKET="product-images"
