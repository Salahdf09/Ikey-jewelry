# Only needed if the frontend is deployed separately from the backend
# (different domain/origin). Leave unset for the recommended cPanel
# single-process deploy — it defaults to the relative "/api", which works
# because the same server serves both the API and the built frontend.
# VITE_API_URL=https://api.your-domain.com/api

# Skips the logo intro animation — handy while iterating locally so you're
# not waiting out the ~2.7s melt on every reload. Leave unset in production.
# VITE_DISABLE_INTRO=true
